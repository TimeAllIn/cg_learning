; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="计算机图形学"
config/description="计算机图形学课程设计
V2.1:增加局域网协作功能"
config/version="2.1"
config/tags=PackedStringArray("git", "课程设计")
run/main_scene="res://美化界面.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="课程设计临时文件夹"
config/features=PackedStringArray("4.3", "GL Compatibility")
boot_splash/bg_color=Color(1, 1, 1, 1)
boot_splash/image="res://素材/新图标.png"
boot_splash/fullsize=false
boot_splash/use_filter=false
config/icon="res://素材/新图标.png"
config/windows_native_icon="res://素材/图标文件.ico"

[autoload]

Data="res://data.gd"
NewData="*res://美化脚本/new_data.gd"

[display]

window/size/viewport_width=1200
window/size/viewport_height=800
window/size/borderless=true
window/size/transparent=true
window/per_pixel_transparency/allowed=true

[gui]

theme/custom_font="res://素材/字体.ttf"

[importer_defaults]

3d_texture={
"compress/mode": 3
}

